# ---- Telegram ----
# Create a bot with @BotFather and paste the token here.
TELEGRAM_BOT_TOKEN=123456:ABC-DEF...

# Optional: a channel/group to broadcast new properties to (e.g. @my_rentals or -1001234567890).
# Leave empty to only message users who interact with the bot.
TELEGRAM_CHANNEL_ID=

# ---- Search scheduling ----
# How often (in minutes) the background job re-runs every saved filter.
SEARCH_INTERVAL_MINUTES=30

# ---- Google Maps (optional) ----
# Only needed if you want server-side geocoding of addresses to lat/lon.
# Map *links* are generated without a key; this only improves pin accuracy.
GOOGLE_MAPS_API_KEY=

# ---- Telegram channel source (most reliable source) ----
# Reading public rental channels uses the Telegram *client* API. Get these from
# https://my.telegram.org (API development tools), then run:
#   python -m rentsearch.telegram_login
# once to create the login session before starting the bot.
TELEGRAM_API_ID=
TELEGRAM_API_HASH=
# Comma-separated public channel usernames to monitor (the @ is optional).
TELEGRAM_CHANNELS=@example_rentals_telaviv,@example_rentals_jerusalem
# Where the Telethon session is stored (no extension; .session is appended).
TELEGRAM_SESSION_PATH=data/telethon

# ---- Storage ----
DATABASE_URL=sqlite:///data/rentsearch.db

# ---- HTTP ----
# Optional outbound proxy for scrapers (e.g. http://user:pass@host:port).
HTTP_PROXY_URL=
REQUEST_TIMEOUT_SECONDS=25
